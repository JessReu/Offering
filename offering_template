<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>Bosch Angebot</title>
    <style>
        /* =========================================================================
           BOSCH CORPORATE DESIGN (CD) STYLESHEET FOR PDF GENERATION
           ========================================================================= */
        @page {
            size: A4;
            margin: 20mm 15mm 20mm 15mm;
            @bottom-left {
                content: "Robert Bosch GmbH | Bosch Connected Industry";
                font-family: 'Aptos Narrow', sans-serif;
                font-size: 8pt;
                color: #525F65;
            }
            @bottom-right {
                content: "Seite " counter(page);
                font-family: 'Aptos Narrow', sans-serif;
                font-size: 8pt;
                color: #525F65;
            }
        }
        
        body {
            font-family: 'Aptos Narrow', 'Arial', sans-serif;
            color: #000000;
            font-size: 11pt;
            line-height: 1.4;
            margin: 0;
            padding: 0;
        }

        /* Bosch Farb-Akzente */
        .bosch-header-line {
            height: 4px;
            background: linear-gradient(to right, #E20015 25%, #005691 25%, #005691 50%, #008ECF 50%, #008ECF 75%, #84BD00 75%);
            margin-bottom: 15px;
        }

        .header-container {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 40px;
        }

        .bosch-logo {
            width: 130px;
            height: auto;
        }

        .document-title {
            font-size: 22pt;
            font-weight: bold;
            color: #005691; /* Bosch Blau */
            margin-top: 0;
            margin-bottom: 5px;
        }

        /* Briefkopf Spalten */
        .meta-table {
            width: 100%;
            margin-bottom: 30px;
            border-collapse: collapse;
        }

        .meta-table td {
            vertical-align: top;
            padding: 2px;
        }

        .address-box {
            width: 60%;
            font-size: 10pt;
        }

        .info-box {
            width: 40%;
            font-size: 9.5pt;
            text-align: right;
        }

        /* Tabellen-Design */
        .product-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            margin-bottom: 30px;
        }

        .product-table th {
            background-color: #F0F4F8;
            color: #005691;
            font-weight: bold;
            text-align: left;
            padding: 10px;
            border-bottom: 2px solid #005691;
            font-size: 10pt;
        }

        .product-table td {
            padding: 10px;
            border-bottom: 1px solid #D1DCE3;
            font-size: 10pt;
            vertical-align: top;
        }

        .total-row {
            font-weight: bold;
            background-color: #F0F4F8;
        }

        /* Rechtstexte-Box */
        .legal-box {
            background-color: #F9FAFB;
            border-left: 3px solid #005691;
            padding: 15px;
            font-size: 9pt;
            color: #333333;
            margin-top: 40px;
        }
    </style>
</head>
<body>

    <!-- Bosch Farb-Aktivitätsband -->
    <div class="bosch-header-line"></div>

    <div class="header-container">
        <div>
            <h1 class="document-title">ANGEBOT</h1>
            <div style="font-size: 11pt; font-weight: bold;">Angebotsnummer: {{ angebotsnummer }}</div>
        </div>
        <!-- Platzhalter für das Logo -->
        <div>
            <img class="bosch-logo" src="https://upload.wikimedia.org/wikipedia/commons/thumb/1/16/Bosch-Logo.svg/1280px-Bosch-Logo.svg.png" alt="Bosch Logo">
        </div>
    </div>

    <!-- Briefkopf (Empfänger & Absenderinfos) -->
    <table class="meta-table">
        <tr>
            <td class="address-box">
                <strong>Empfänger:</strong><br>
                {{ kunden_name }}<br>
                {{ kunden_adresse | replace('\n', '<br>') }}
            </td>
            <td class="info-box">
                <strong>Datum:</strong> {{ datum }}<br>
                <strong>InStep-Nr:</strong> {{ instep_nummer }}<br>
                <strong>Zahlungsziel:</strong> 30 Tage netto<br>
                <strong>Ihr Ansprechpartner:</strong> {{ product_owner }}
            </td>
        </tr>
    </table>

    <hr style="border: 0; border-top: 1px solid #D1DCE3; margin-bottom: 25px;">

    <!-- Anschreibetext -->
    <div style="margin-bottom: 30px;">
        <p>{{ intro_text | replace('\n', '<br>') }}</p>
    </div>

    <!-- Leistungstabelle -->
    <h3>Angebotene SaaS-Leistungen</h3>
    <table class="product-table">
        <thead>
            <tr>
                <th>Pos.</th>
                <th>Beschreibung</th>
                <th>Menge</th>
                <th>Einheit</th>
                <th>Einzelpreis (Netto)</th>
                <th>Gesamtpreis (Netto)</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>1</td>
                <td>
                    <strong>{{ produkt_name }}</strong><br>
                    <span style="font-size: 8.5pt; color: #525F65;">{{ produkt_beschreibung }}</span>
                </td>
                <td>{{ saas_menge }}</td>
                <td>{{ einheit }}</td>
                <td style="text-align: right;">{{ einzelpreis }} €</td>
                <td style="text-align: right; font-weight: bold;">{{ gesamtpreis }} €</td>
            </tr>
            <tr class="total-row">
                <td colspan="5" style="text-align: right;">Gesamtsumme (Netto):</td>
                <td style="text-align: right;">{{ gesamtpreis }} €</td>
            </tr>
        </tbody>
    </table>

    <!-- Rechtliche Bedingungen (AGBs) -->
    <div class="legal-box">
        {{ vertragsbedingungen | replace('\n', '<br>') }}
    </div>

</body>
</html>
